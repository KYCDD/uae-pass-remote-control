# Configuration for the agent. On a real Windows deployment these are usually
# set as machine environment variables (see docs/windows-desktop-agent.md); this
# file is for local development, and is read by bin/run-task.js via dotenv.
#
# Every variable the agent reads lives in src/config.js.

# ---- required ---------------------------------------------------------------

# Shared with KYCDD as remote_browser_agent_token / remote_browser_agent_secret.
# Required by the HTTP server (npm run serve); a local `npm run task` does not
# need them. The token says which caller this is; the secret signs each request.
REMOTE_AGENT_TOKEN=
REMOTE_AGENT_SECRET=

# ---- how a task is worked ---------------------------------------------------

# deterministic = work known services from a scripted recipe, with NO external AI
#                 (see src/flows). The default. Needs no model key.
# ai            = always use the model-driven loop.
REMOTE_AGENT_MODE=deterministic

# May a deterministic run that gets stuck hand off to the model? Set to 0 to never
# use the model at all (and then OPENAI_API_KEY / REMOTE_AGENT_MODEL are not needed).
REMOTE_AGENT_AI_FALLBACK=1

# Only needed for the AI path or fallback. Optional otherwise.
OPENAI_API_KEY=
REMOTE_AGENT_MODEL=

# ---- which surface a run drives ---------------------------------------------

# browser = a real Chromium via Puppeteer (enforces origins, records the network
#           log, can `capture`). The deterministic recipes drive this surface.
# desktop = the real Windows mouse, keyboard and screen (reaches native dialogs
#           and browsers that refuse automation; cannot see URLs or traffic).
REMOTE_AGENT_SURFACE=browser

# Desktop surface: pushing the mouse pointer into the top-left corner of the main
# screen stops a run (the terminal loses focus, so Ctrl-C can't). 0 turns it off.
# REMOTE_AGENT_DESKTOP_FAILSAFE=1

# Desktop surface, capturing tasks (e.g. --capture growth_session): the 127.0.0.1
# debugging port of the real Chrome it starts. Any local process can drive that
# Chrome while it runs.
# REMOTE_AGENT_DESKTOP_CHROME_PORT=9333

# ---- deterministic recipe selectors -----------------------------------------

# DOM selectors for the Growth recipe, as JSON. Discover them against the live
# pages with: node bin/inspect-dom.js https://www.growth.gov.ae/G2C/
# Until the essential keys are set, Growth falls back to the model.
# REMOTE_AGENT_GROWTH_SELECTORS={"loginButton":"#login","idField":"#eid","idSubmit":"#submit","enquiryNav":"...","licenceInput":"...","searchButton":"...","firstResult":"...","exportButton":"..."}
# REMOTE_AGENT_GROWTH_COOKIES={"session":"nr2Users","identity":"IdentityTokenId"}

# ---- server (optional) ------------------------------------------------------

# REMOTE_AGENT_HOST=127.0.0.1
# REMOTE_AGENT_PORT=8787

# ---- credentials ------------------------------------------------------------

# Portal credentials are resolved by alias. KYCDD never sends a secret; it sends
# the alias and this machine looks it up, from credentials.json and/or from
# REMOTE_AGENT_CRED_<ALIAS>_* variables. See credentials.example.json.
# REMOTE_AGENT_CREDENTIALS_FILE=./credentials.json
# REMOTE_AGENT_CRED_GROWTH_UAE_PASS_USERNAME=
# REMOTE_AGENT_CRED_GROWTH_UAE_PASS_PASSWORD=

# Persistent browser profiles (browser surface), one per credential alias. This
# is what makes a session survive between runs. Deleting it signs every portal out.
# REMOTE_AGENT_PROFILE_DIR=./profiles

# ---- which Chrome (to get past bot checks like reCAPTCHA) --------------------

# By default the agent drives the installed Google Chrome with the automation
# flags stripped (navigator.webdriver removed, no --enable-automation banner),
# which looks far more human than Puppeteer's bundled Chromium. Set to blank to
# force the bundled Chromium, or give an explicit path.
# REMOTE_AGENT_CHROME_CHANNEL=chrome
# REMOTE_AGENT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Strongest option: drive a Chrome YOU launched, so a human can solve any CAPTCHA
# and the session has real history. Launch Chrome with a debugging port:
#   "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\kycdd-agent-chrome"
# then point the agent at it (it attaches instead of launching, and never closes it):
# REMOTE_AGENT_CHROME_DEBUG_URL=http://127.0.0.1:9222

# ---- UAE Pass app approval (optional, opt-in) -------------------------------

# How a UAE Pass sign-in approval is satisfied. A deliberate choice:
#   assist : alert the operator and wait while THEY approve on the phone; the run
#            survives the step, a person still approves. src/twofactor/HumanApproval.js
#   auto   : approve by itself on an Android emulator, unattended. src/twofactor/UaePassApp.js
#   off    : (default) fall back to a typed code from a file.
# REMOTE_AGENT_UAE_PASS_APPROVAL=off        # "assist" (human taps) or "auto" (unattended)
# REMOTE_AGENT_UAE_PASS_ALERT_SOUND=1       # "assist" beeps the desktop; set 0 for bell only
# REMOTE_AGENT_ADB=adb                       # accepts any adb serial, emulator or real device
# REMOTE_AGENT_EMULATOR_SERIAL=emulator-5554
# REMOTE_AGENT_UAE_PASS_PACKAGE=ae.uaepass.mainapp

# The passcode, if the approval is confirmed by a PIN. A secret: it is used only
# to choose which on-screen keypad keys to tap, is never sent to adb as text, and
# is never logged. Leave unset to rely on the fingerprint step (emulator only).
# REMOTE_AGENT_UAE_PASS_PIN=
# REMOTE_AGENT_UAE_PASS_CONFIRM_TEXT=confirm,login,continue   # labels that submit the PIN
